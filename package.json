{
  "name": "lumenode-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Explore. Understand. Build. - Open-source CS Learning Platform",
  "scripts": {
    "dev": "pnpm --filter @lumenode/web dev",
    "build": "pnpm --filter @lumenode/web build",
    "lint": "pnpm --filter @lumenode/web run lint",
    "test": "pnpm --filter @lumenode/web run test",
    "typecheck": "pnpm --filter @lumenode/shared-types run typecheck && pnpm --filter @lumenode/web run typecheck",
    "content:validate": "tsx scripts/content-validate.ts",
    "content:check-links": "tsx scripts/content-validate.ts --check-links",
    "content:test": "pnpm test",
    "content:build": "pnpm build"
  },
  "keywords": [
    "education",
    "computer-science",
    "algorithms",
    "data-structures",
    "interactive-visualizer"
  ],
  "author": "Lumenode Contributors",
  "license": "Apache-2.0",
  "type": "module",
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
